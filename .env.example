# Sample configuration. Copy this file to `.env` and fill in real values.
# `.env` is git-ignored, so your real secrets never get committed.

PORT=3000
NODE_ENV=production

# Avalik aadress (kasutatakse e-kirjade linkides, sitemapis ja canonical-siltides)
PUBLIC_URL=https://www.eservice.ee

# Andmebaasi ja üleslaaditud failide kaust (varunda seda!)
DATA_DIR=./data

# Halduse peakasutaja "admin" esmane parool. Kui puudub, genereeritakse ja trükitakse konsooli.
ADMIN_PASSWORD=

# Kui rakendus on pöördproksi (nginx, Cloudflare) taga: true või proksi IP
TRUST_PROXY=

# E-post (SMTP). Ilma SMTP_HOST-ita päringud salvestuvad, aga teavitusi ei saadeta.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="E-Service AS koduleht <noreply@eservice.ee>"

# Testkeskkonnas: kõik kirjad ühele aadressile (algsed saajad kirjutatakse kirja algusesse)
MAIL_REDIRECT_TO=

# Kinnituskiri kliendile pärast päringut (true/false)
SEND_CUSTOMER_CONFIRMATION=true

# Päringuvormi piirang: mitu päringut ühelt IP-lt 15 minuti jooksul
FORM_RATE_LIMIT=10
